<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="BackGround" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.MRequestsGui">
    <Label layoutX="135.0" layoutY="5.0" text="Requests" textFill="WHITE">
        <font>
          <Font size="14.0" />
        </font>
    </Label>
    <Button fx:id="ExitButton" layoutY="2.0" mnemonicParsing="false" text="Exit" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
    <Button fx:id="MainMenuButton" layoutX="35.0" mnemonicParsing="false" onAction="#goMainMenu" text="MainMenu" AnchorPane.topAnchor="0.0" />
    <Button fx:id="RecommendationButton" layoutX="489.0" layoutY="1.0" mnemonicParsing="false" onAction="#goRecommendation" text="Recommendation" AnchorPane.topAnchor="1.0" />
    <Button fx:id="EnrollmentCertificateButton" layoutX="360.0" layoutY="1.0" mnemonicParsing="false" onAction="#goEnrollmentCertificate" text="Enrollment certificate" />
    <Button fx:id="DormitoryButton" layoutX="289.0" layoutY="1.0" mnemonicParsing="false" onAction="#goDormitory" text="Dormitory" />
    <Button fx:id="WithdrawalButton" layoutX="213.0" layoutY="1.0" mnemonicParsing="false" onAction="#goWithdrawal" text="Withdrawal" AnchorPane.topAnchor="1.0" />
</AnchorPane>
