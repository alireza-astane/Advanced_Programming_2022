<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GuiControllers.RecordGui">

    <Button fx:id="TemporaryScoresButton" layoutX="501.0" mnemonicParsing="false" onAction="#goTemporaryScores"
            text="Temporary Scores" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
    <Button fx:id="EducationalSituationButton" layoutX="377.0" layoutY="1.0" mnemonicParsing="false"
            onAction="#goEducationalSituationLIst" text="Educational Situation" AnchorPane.topAnchor="0.0"/>
    <Button fx:id="ExitButton" layoutX="8.0" layoutY="2.0" mnemonicParsing="false" onAction="#goExit" text="Exit"
            AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0"/>
    <Button fx:id="MainMenuButton" layoutX="35.0" layoutY="2.0" mnemonicParsing="false" onAction="#goMainMenu"
            text="MainMenu" AnchorPane.topAnchor="0.0"/>
    <Label fx:id="PageLabel" layoutX="250.0" layoutY="5.0" text="Record" textFill="WHITE">
        <font>
            <Font size="14.0"/>
        </font>
    </Label>
</AnchorPane>
