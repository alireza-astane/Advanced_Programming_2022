<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="BackGround" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.WithdrawalGui">
   <Button fx:id="ExitButton" mnemonicParsing="false" onAction="#goExit" text="Exit" />
   <Button fx:id="MainMenuButton" layoutX="35.0" layoutY="1.0" mnemonicParsing="false" onAction="#goMainMenu" prefHeight="26.0" prefWidth="82.0" text="Main Menu" AnchorPane.topAnchor="0.0" />
   <Button fx:id="RequestButton" layoutX="474.0" layoutY="187.0" mnemonicParsing="false" onAction="#doWithdrawalRequestButton" text="Request" />
   <Label layoutX="238.0" layoutY="4.0" text="Withdrawal Request" textFill="WHITE">
      <font>
         <Font size="14.0" />
      </font>
   </Label>
</AnchorPane>
