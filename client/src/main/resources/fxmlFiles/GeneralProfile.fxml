<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="BackGround" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.GeneralProfileGui">
    <Button fx:id="ExitButton" layoutX="2.0" layoutY="2.0" mnemonicParsing="false" onAction="#goExit" text="Exit" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
    <Button fx:id="MainMenuButton" layoutX="36.0" mnemonicParsing="false" onAction="#goMainMenu" text="Main Menu" />
    <Label layoutX="280.0" layoutY="4.0" text="Profile" textFill="WHITE">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
    <ColorPicker fx:id="ColorPicker" layoutX="-2.0" layoutY="26.0" onAction="#doChangeBackGround" prefHeight="26.0" prefWidth="114.0">
        <value>
            <Color />
        </value>
    </ColorPicker>
</AnchorPane>
