<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="BackGround" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.ChangePasswordGui">
   <Label layoutX="244.0" layoutY="49.0" text="Change PassWord" textFill="WHITE">
      <font>
         <Font size="14.0" />
      </font>
   </Label>
   <TextField fx:id="CurrentPassField" layoutX="80.0" layoutY="139.0" promptText="Enter Current Pass" />
   <TextField fx:id="NewPassField" layoutX="81.0" layoutY="187.0" promptText="Enter New Pass" />
   <TextField fx:id="ConfirmPassField" layoutX="81.0" layoutY="233.0" promptText="Confirm New Pass" />
   <Button fx:id="ChangePassButton" layoutX="381.0" layoutY="233.0" mnemonicParsing="false" onAction="#doChangePassword" text="Change Pass" />
   <Button fx:id="ExitButton" layoutY="-1.0" mnemonicParsing="false" onAction="#goExit" text="Exit" />
   <Label fx:id="ErrorLabel" layoutX="252.0" layoutY="143.0" prefHeight="18.0" prefWidth="206.0" textFill="RED" />
   <Label fx:id="result" layoutX="286.0" layoutY="91.0" />
</AnchorPane>
