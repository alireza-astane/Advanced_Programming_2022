<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="BackGround" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.CWAddExercise">
   <children>
      <Button fx:id="exitbutton" layoutY="1.0" mnemonicParsing="false" onAction="#goexit" text="Log Out" />
      <Button fx:id="mainmenubutton" layoutX="59.0" layoutY="1.0" mnemonicParsing="false" onAction="#gomainmenu" text="Main Menu" />
      <Button fx:id="cwmenubutton" layoutX="134.0" layoutY="1.0" mnemonicParsing="false" onAction="#gocwmenu" text="Courseware Menu" />
      <Label layoutX="406.0" layoutY="14.0" text="Add Exercise" />
      <TextField fx:id="namefield" layoutX="695.0" layoutY="103.0" promptText="name" />
      <TextField fx:id="openfield" layoutX="696.0" layoutY="154.0" promptText="open time" />
      <TextField fx:id="deadfield" layoutX="696.0" layoutY="200.0" promptText="deadline" />
      <TextField fx:id="closefield" layoutX="697.0" layoutY="248.0" promptText="closetime" />
      <TextField fx:id="explanationfield" layoutX="698.0" layoutY="283.0" promptText="ecplanation" />
      <TextArea fx:id="textfield" layoutX="389.0" layoutY="358.0" prefHeight="69.0" prefWidth="458.0" />
      <Button fx:id="addfilebutton" layoutX="793.0" layoutY="448.0" mnemonicParsing="false" text="add file" />
      <RadioButton fx:id="radiobuttonfile" layoutX="386.0" layoutY="452.0" mnemonicParsing="false" onAction="#setfile" text="file" />
      <RadioButton fx:id="rodiobuttontext" layoutX="273.0" layoutY="452.0" mnemonicParsing="false" onAction="#settext" text="text" />
      <Button fx:id="setcommit" layoutX="795.0" layoutY="531.0" mnemonicParsing="false" onAction="#docommit" text="commit" />
      <Label fx:id="filename" layoutX="729.0" layoutY="452.0" text="Label" />
   </children>
</AnchorPane>
