<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="BackGround" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.ATemporaryScoreGui">
    <Button layoutY="2.0" mnemonicParsing="false" text="Exit" AnchorPane.topAnchor="0.0" />
    <Button fx:id="MainMenu" layoutX="35.0" layoutY="2.0" mnemonicParsing="false" text="MainMenu" AnchorPane.topAnchor="0.0" />
    <Label layoutX="141.0" layoutY="6.0" text="Page Label" textFill="WHITE" />
    <TextField fx:id="SubjectNumField" layoutX="494.0" layoutY="74.0" prefHeight="26.0" prefWidth="109.0" promptText="Subject Num" />
    <ScrollPane layoutY="125.0" prefHeight="307.0" prefWidth="616.0">
        <TableView fx:id="DataTable" prefHeight="310.0" prefWidth="618.0">
            <columns>
                <TableColumn fx:id="studentName" prefWidth="97.59994131326675" text="Student Name" />
                <TableColumn fx:id="course" prefWidth="79.20001220703125" text="Subject" />
                <TableColumn fx:id="score" prefWidth="56.0" text="Score" />
                <TableColumn fx:id="protestation" prefWidth="185.6000518798828" text="Protestation" />
                <TableColumn fx:id="answer" prefWidth="183.99993896484375" text="Answer" />
            </columns>
        </TableView>
    </ScrollPane>
    <TextField fx:id="MasterNameField" layoutX="367.0" layoutY="73.0" prefHeight="26.0" prefWidth="109.0" promptText="Master Name" />
    <TextField fx:id="StudentNameField" layoutX="242.0" layoutY="73.0" prefHeight="26.0" prefWidth="109.0" promptText="Student Name" />
    <Button fx:id="SearchButton" layoutX="155.0" layoutY="73.0" mnemonicParsing="false" onAction="#doSearch" text="Search" />
</AnchorPane>
