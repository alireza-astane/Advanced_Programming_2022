<?xml version="1.0" encoding="UTF-8"?>

<?import com.gluonhq.charm.glisten.control.ToggleButtonGroup?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id ="BackGround" prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GuiControllers.CWAddEducationalContext ">
   <children>
      <Button fx:id="exit-button" mnemonicParsing="false" onAction="#goexit" text="Log Out" />
      <Button fx:id="menu-button" layoutX="59.0" layoutY="1.0" mnemonicParsing="false" onAction="#gomainmenu" text="Main Menu" AnchorPane.topAnchor="0.0" />
      <Button fx:id="bellybutton" layoutX="136.0" mnemonicParsing="false" onAction="#gocwmenu" text="Courseware Menu" />
      <Label layoutX="370.0" layoutY="3.0" prefHeight="18.0" prefWidth="214.0" text="Add new Educational Context" />
      <ToggleButtonGroup layoutX="290.0" layoutY="197.0" selectionType="SINGLE" />
      <TextField fx:id="title label" layoutX="667.0" layoutY="127.0" promptText="title" />
      <Button fx:id="upload-button" layoutX="97.0" layoutY="127.0" mnemonicParsing="false" onAction="#upload" text="Upload File" />
      <Label fx:id="filename-label" layoutX="178.0" layoutY="131.0" text="file name" />
      <TextArea fx:id="text-field" layoutX="227.0" layoutY="223.0" prefHeight="94.0" prefWidth="591.0" />
      <Button fx:id="commit button" layoutX="95.0" layoutY="350.0" mnemonicParsing="false" onAction="#commit" text="Commit" />
      <RadioButton fx:id="radiobutton-text" layoutX="216.0" layoutY="354.0" mnemonicParsing="false" onAction="#settext" text="text" />
      <RadioButton fx:id="radiobutton-file" layoutX="272.0" layoutY="354.0" mnemonicParsing="false" onAction="#setfile" text="file" />
   </children>
</AnchorPane>
